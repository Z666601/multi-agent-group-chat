# ── 群聊服务环境变量样例 ─────────────────────────────
# 复制为 .env 后按需修改（本项目零依赖，无需 npm install）

# 监听地址与端口
HOST=127.0.0.1
PORT=8787

# 数据目录（SQLite 数据库、上传文件、日志都放这里）
DATA_DIR=./data

# 可选：单独指定数据库文件与日志目录（默认在 DATA_DIR 下）
# DB_FILE=./data/chat.db
# LOG_DIR=./data/logs

# 日志级别：debug | info | warn | error | silent
LOG_LEVEL=info

# 业务限额
MAX_TEXT_LENGTH=2000
MAX_IMAGE_MB=5
MAX_GROUP_MEMBERS=200

# 管理令牌（用于 /api/admin/* 台账与指标查询）
# 留空则管理接口整体关闭；生产环境请改成足够长的随机串
ADMIN_TOKEN=change-me-to-a-long-random-string
